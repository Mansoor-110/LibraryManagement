@model IEnumerable<LibraryManagement.Models.Book>

<!-- Team Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Books</h6>
            <h1 class="mb-5">Wide Range Of Books!</h1>
        </div>
        <div class="row g-3 justify-content-center">
            @foreach (var item in Model)
            {
                <!-- Book Card-->
                <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-6 d-flex justify-content-center wow fadeInUp" data-wow-delay="0.1s">
                    <div class="team-item bg-light w-100" style="max-width: 222px;">
                        <div class="overflow-hidden">
                            <img class="img-fluid w-100" src="~/BookImages/@item.BookImageName" alt="@item.BookName">
                            <div class="text-center p-3">
                                <h5 class="mb-1" style="font-size: 15px;">@item.BookName</h5>
                                <a asp-action="BooksDetail" asp-route-id="@item.BookId" asp-controller="Home"><small>Details</small></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Book Card-->
            }
        </div>
    </div>
</div>
<!-- Team End -->