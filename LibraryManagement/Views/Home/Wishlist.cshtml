@model List<LibraryManagement.Models.WishlistItemVM>

<style>
    * {
        box-sizing: border-box;
    }

    .cart-wrap {
        background: #fff;
        padding: 30px 15px 60px;
    }

    .cart-summary-bar {
        max-width: 1100px;
        margin: 0 auto 20px;
        font-size: 13px;
        color: #555;
    }

        .cart-summary-bar strong {
            color: #1a2340;
        }

    .cart-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .cart-item-card {
        display: flex;
        align-items: center;
        border: 1px solid #eef1f6;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
        padding: 12px;
        gap: 12px;
        transition: box-shadow 0.25s ease, transform 0.25s ease;
    }

        .cart-item-card:hover {
            box-shadow: 0 8px 20px rgba(26,35,64,0.08);
        }

    .cart-item-img {
        flex: 0 0 75px;
        width: 75px;
        height: 95px;
        border-radius: 6px;
        background: #f4f6f9;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .cart-item-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .cart-stock-badge {
        display: inline-block;
        font-size: 10px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 10px;
        color: #fff;
        margin-top: 4px;
    }

        .cart-stock-badge.in {
            background: #00bcd4;
        }

        .cart-stock-badge.out {
            background: #e74c3c;
        }

    .cart-item-body {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-width: 0;
    }

    .cart-item-info {
        flex: 1 1 auto;
        min-width: 0;
    }

    .cart-item-title {
        font-size: 15px;
        font-weight: 700;
        color: #1a2340;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cart-item-author {
        font-size: 12px;
        color: #777;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cart-item-divider {
        width: 1px;
        height: 40px;
        background: #eef1f6;
        flex: 0 0 1px;
    }

    .cart-item-price-block {
        flex: 0 0 auto;
        text-align: center;
    }

    .cart-item-price-label {
        font-size: 10px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #888;
        margin-bottom: 2px;
    }

    .cart-item-price {
        font-size: 15px;
        font-weight: 700;
        color: #1a2340;
        white-space: nowrap;
    }

    .cart-item-actions {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .cart-item-actions form {
            margin: 0;
        }

    .cart-move-btn, .cart-remove-btn {
        white-space: nowrap;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        border-radius: 4px;
        transition: all 0.2s ease;
    }

    .cart-move-btn {
        background: #00bcd4;
        color: #fff;
        border: 1px solid #00bcd4;
    }

        .cart-move-btn:hover {
            background: #0097a7;
        }

    .cart-remove-btn {
        background: transparent;
        color: #e74c3c;
        border: 1px solid #e74c3c;
    }

        .cart-remove-btn:hover {
            background: #e74c3c;
            color: #fff;
        }

    .cart-empty {
        text-align: center;
        padding: 50px 20px;
    }

    .cart-browse-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #1a2340;
        color: #fff;
        padding: 10px 20px;
        font-size: 13px;
        border-radius: 4px;
        text-decoration: none;
    }

    /* Mobile specific adjustments to keep horizontal layout compact */
    @@media (max-width: 600px) {
        .cart-wrap {
            padding: 15px 8px;
        }

        .cart-item-card {
            padding: 8px;
            gap: 8px;
        }

        .cart-item-img {
            flex: 0 0 55px;
            width: 55px;
            height: 75px;
        }

        .cart-item-body {
            gap: 6px;
        }

        .cart-item-title {
            font-size: 13px;
        }

        .cart-item-author {
            font-size: 11px;
        }

        .cart-item-divider {
            display: none;
        }

        .cart-item-price-block {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        .cart-item-price-label {
            display: none;
        }

        .cart-item-price {
            font-size: 13px;
        }

        .cart-item-actions {
            flex-direction: column;
            gap: 4px;
        }

        .cart-move-btn, .cart-remove-btn {
            padding: 5px 8px;
            font-size: 10px;
            width: 100%;
        }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<div class="text-center wow fadeInUp" data-wow-delay="0.1s">
    <h6 class="section-title bg-white text-center text-primary px-3">Wishlist</h6>
    <h1 class="mb-4 mb-md-5">Your Wishlist</h1>
</div>

<div class="cart-wrap">

    @if (!Model.Any())
    {
        <div class="cart-empty">
            <p>Aapki wishlist abhi khaali hai.</p>
            <a asp-action="Index" asp-controller="Home" class="cart-browse-btn">
                <i class="ti ti-arrow-left" aria-hidden="true"></i>
                Browse Books
            </a>
        </div>
    }
    else
    {
        <div class="cart-summary-bar">
            <strong>@Model.Count</strong> item(s) in your wishlist
        </div>

        <div class="cart-list">
            @foreach (var item in Model)
            {
                <div class="cart-item-card">
                    <div class="cart-item-img">
                        <img src="~/BookImages/@item.BookImageName" alt="@item.BookName" />
                    </div>
                    <div class="cart-item-body">
                        <div class="cart-item-info">
                            <div class="cart-item-title" title="@item.BookName">@item.BookName</div>
                            <div class="cart-item-author">@item.BookAuthor</div>
                            <div>
                                @if (item.Quantity > 0)
                                {
                                    <span class="cart-stock-badge in">In Stock</span>
                                }
                                else
                                {
                                    <span class="cart-stock-badge out">Out of Stock</span>
                                }
                            </div>
                        </div>

                        <div class="cart-item-divider"></div>

                        <div class="cart-item-price-block">
                            <div class="cart-item-price-label">Price</div>
                            <div class="cart-item-price">Rs. @item.BookPrice</div>
                        </div>

                        <div class="cart-item-actions">
                            <form asp-action="MoveToCart" asp-controller="Home" asp-route-id="@item.WishlistItemId" method="post">
                                <button type="submit" class="cart-move-btn">Move to Cart</button>
                            </form>
                            <form asp-action="RemoveFromWishlist" asp-controller="Home" asp-route-id="@item.WishlistItemId" method="post">
                                <button type="submit" class="cart-remove-btn">Remove</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>