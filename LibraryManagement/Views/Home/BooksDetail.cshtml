@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<style>
    /* Scoped Detail Page Styles (No Global Overrides) */
    .page-wrap {
        background: #fff;
        padding: 40px 20px;
    }

    .section-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2px;
        color: #00bcd4;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

        .section-label::before, .section-label::after {
            content: '';
            display: block;
            width: 40px;
            height: 2px;
            background: #00bcd4;
        }

    .section-title {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: #1a2340;
        margin-bottom: 40px;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 40px;
        max-width: 960px;
        margin: 0 auto;
        align-items: center;
    }

    .img-col {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .main-img {
        width: 100%;
        max-width: 350px;
        border-radius: 6px;
        overflow: hidden;
        background: #e8f4f8;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

        .main-img img {
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
        }

    .badge-bestseller {
        position: absolute;
        top: 16px;
        left: 16px;
        background: #00bcd4;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 2px;
        z-index: 2;
    }

    .info-col {
        padding-top: 4px;
    }

    .book-title {
        font-size: 26px;
        font-weight: 700;
        color: #1a2340;
        line-height: 1.3;
        margin-bottom: 10px;
    }

    .rating-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
    }

    .stars {
        color: #f5a623;
        font-size: 15px;
        letter-spacing: 1px;
    }

    .rating-text {
        font-size: 13px;
        color: #888;
    }

    .price-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 10px;
    }

    .price-now {
        font-size: 28px;
        font-weight: 700;
        color: #1a2340;
    }

    .price-old {
        font-size: 16px;
        color: #bbb;
        text-decoration: line-through;
    }

    .price-save {
        font-size: 12px;
        font-weight: 600;
        color: #00bcd4;
        background: #e0f7fa;
        padding: 3px 8px;
        border-radius: 2px;
    }

    .divider {
        border: none;
        border-top: 1px solid #eee;
        margin: 20px 0;
    }

    .desc {
        font-size: 14px;
        color: #555;
        line-height: 1.8;
        margin-bottom: 22px;
    }

    .meta-list {
        list-style: none;
        margin-bottom: 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 0;
    }

        .meta-list li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: #444;
        }

            .meta-list li span.label {
                color: #888;
                min-width: 80px;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

    .meta-icon {
        color: #00bcd4;
        font-size: 16px;
    }

    .qty-row {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 22px;
    }

    .qty-label {
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .qty-ctrl {
        display: flex;
        align-items: center;
        border: 1px solid #ddd;
        border-radius: 2px;
        overflow: hidden;
    }

    .qty-btn {
        width: 34px;
        height: 34px;
        background: #f5f5f5;
        border: none;
        cursor: pointer;
        font-size: 18px;
        color: #1a2340;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s;
    }

        .qty-btn:hover {
            background: #e0f7fa;
            color: #00bcd4;
        }

    .qty-val {
        width: 40px;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
        color: #1a2340;
    }

    /* Isolated Button Container */
    .btn-row-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 22px;
    }

    .btn-row {
        display: flex;
        gap: 12px;
        width: 100%;
    }

    .btn-detail-cart {
        flex: 1;
        background: #00bcd4;
        color: #fff;
        border: 1.5px solid #00bcd4;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        cursor: pointer;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s;
        text-decoration: none;
    }

        .btn-detail-cart:hover {
            background: #0097a7;
            border-color: #0097a7;
            color: #fff;
        }

    .borrow-btn {
        width: 100%;
        background: #1a2340;
        color: #fff;
        border: 1.5px solid #1a2340;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        cursor: pointer;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s;
        text-decoration: none;
    }

        .borrow-btn:hover {
            background: transparent;
            color: #1a2340;
        }

    .btn-wishlist {
        width: 46px;
        height: 46px;
        background: transparent;
        border: 1.5px solid #ddd;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888;
        font-size: 18px;
        transition: all 0.2s;
        flex-shrink: 0;
    }

        .btn-wishlist:hover {
            border-color: #e91e63;
            color: #e91e63;
        }

    @@media (max-width: 768px) {
        .detail-grid {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .main-img {
            max-width: 100%;
        }

        .book-title {
            font-size: 22px;
        }

        .btn-row-group {
            gap: 10px;
        }

        .page-wrap {
            padding: 20px 15px;
        }
    }
</style>

<div class="page-wrap container mt-3">
    @if (TempData["ExistingMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ExistingMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
        <h6 class="section-title bg-white text-center text-primary px-3">Books</h6>
        <h1 class="mb-5">Wide Range Of Books!</h1>
    </div>

    <div class="detail-grid">
        <!-- Left Image -->
        <div class="img-col">
            <div class="main-img">
                <img src="~/BookImages/@Model.BookImageName" alt="@Model.BookName" />
            </div>
            <span class="badge-bestseller">Bestseller</span>
        </div>

        <!-- Right Info -->
        <div class="info-col">
            <h1 class="book-title">@Model.BookName</h1>

            <div class="rating-row">
                <span class="stars">★★★★★</span>
                <span class="rating-text">4.9 (238 reviews)</span>
            </div>

            <div class="price-row">
                <span class="price-now">Rs.@Model.BookPrice</span>
                @{
                    int price = Model.BookPrice;
                    double percent = 25;
                    int oldPrice = (int)(price + (price * percent / 100));
                }
                <span class="price-old">Rs.@oldPrice</span>
                <span class="price-save">Save 25%</span>
            </div>

            <hr class="divider">

            <p class="desc">
                @Model.BookDescription
            </p>

            <ul class="meta-list">
                <li>
                    <i class="ti ti-user meta-icon" aria-hidden="true"></i>
                    <span class="label">Author</span>
                    <strong>@Model.BookAuthor</strong>
                </li>
                <li>
                    <i class="ti ti-file-text meta-icon" aria-hidden="true"></i>
                    <span class="label">Pages</span>
                    @Model.BookPages
                </li>
                <li>
                    <i class="ti ti-language meta-icon" aria-hidden="true"></i>
                    <span class="label">Language</span>
                    @Model.BookLanguage
                </li>
                <li>
                    <i class="ti ti-check meta-icon" aria-hidden="true"></i>
                    <span class="label">Stock</span>
                    @if (Model.quantity > 0)
                    {
                        <span style="color:#00bcd4; font-weight:600;">In Stock</span>
                    }
                    else
                    {
                        <span style="color:#e91e63; font-weight:600;">Out Of Stock</span>
                    }
                </li>
            </ul>

            <!-- Forms & Actions -->
            <form asp-action="AddToCart" asp-controller="Home" method="post" id="addToCartForm">
                <input type="hidden" name="id" value="@Model.BookId" />
                <input type="hidden" name="quantity" id="quantityInput" value="1" />

                <div class="qty-row">
                    <span class="qty-label">Quantity</span>
                    <div class="qty-ctrl">
                        <button type="button" class="qty-btn" onclick="changeQty(-1)">−</button>
                        <span class="qty-val" id="qty">1</span>
                        <button type="button" class="qty-btn" onclick="changeQty(1)">+</button>
                    </div>
                </div>
            </form>

            <form asp-action="AddToWishlist" asp-controller="Home" method="post" id="addToWishlistForm">
                <input type="hidden" name="id" value="@Model.BookId" />
            </form>

            <div class="btn-row-group">
                <div class="btn-row">
                    <button type="submit" form="addToCartForm" class="btn-detail-cart">
                        <i class="ti ti-shopping-cart" aria-hidden="true"></i>
                        Add to Cart
                    </button>

                    <button type="submit" form="addToWishlistForm" class="btn-wishlist" title="Add to wishlist">
                        <i class="ti ti-heart" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="btn-row">
                    <a asp-action="BorrowRequest" asp-controller="Home" asp-route-id="@Model.BookId" class="borrow-btn">
                        <i class="ti ti-arrow-bear-left" aria-hidden="true"></i>
                        Borrow
                    </a>
                </div>
            </div>

            <hr class="divider">
        </div>
    </div>
</div>

<script>
    let qty = 1;

    function changeQty(d) {
        qty = Math.max(1, qty + d);
        document.getElementById('qty').textContent = qty;
        document.getElementById('quantityInput').value = qty;
    }
</script>