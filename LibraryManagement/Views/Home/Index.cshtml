@model List<LibraryManagement.Models.FeaturedBookVM>
@{
    ViewData["Title"] = "Home Page";
    var userId = Context.Session.GetInt32("UserId");
}

<!-- Carousel Start -->
<div class="container-fluid p-0 mb-5">
    <div class="owl-carousel header-carousel position-relative">
        <div class="owl-carousel-item position-relative">
            <img class="img-fluid" src="~/assets/img/carousel-1.jpg" alt="">
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center" style="background: rgba(24, 29, 56, .7);">
                <div class="container">
                    <div class="row justify-content-start">
                        <div class="col-sm-10 col-lg-8">
                            <h5 class="text-primary text-uppercase mb-3 animated slideInDown">Your Library, Anytime</h5>
                            <h1 class="display-3 text-white animated slideInDown">Discover Your Next Great Read</h1>
                            <p class="fs-5 text-white mb-4 pb-2">Browse our growing collection, borrow with a click, and keep track of everything you're reading — all in one place.</p>
                            <a asp-action="Books" asp-controller="Home" class="btn btn-primary py-md-3 px-md-5 me-3 animated slideInLeft">Browse Books</a>
                            @if (userId == null)
                            {
                                <a asp-action="Register" asp-controller="Home" class="btn btn-light py-md-3 px-md-5 animated slideInRight">Register Now</a>

                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="owl-carousel-item position-relative">
            <img class="img-fluid" src="~/assets/img/carousel-2.jpg" alt="">
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center" style="background: rgba(24, 29, 56, .7);">
                <div class="container">
                    <div class="row justify-content-start">
                        <div class="col-sm-10 col-lg-8">
                            <h5 class="text-primary text-uppercase mb-3 animated slideInDown">A Library Built for Readers</h5>
                            <h1 class="display-3 text-white animated slideInDown">Borrow, Read, Return — Simplified</h1>
                            <p class="fs-5 text-white mb-4 pb-2">No more waiting in line or losing track of due dates. Manage your entire borrowing history from your own profile.</p>
                            <a asp-action="Books" asp-controller="Home" class="btn btn-primary py-md-3 px-md-5 me-3 animated slideInLeft">Browse Books</a>
                            @if (userId == null)
                            {

                                <a asp-action="Register" asp-controller="Home" class="btn btn-light py-md-3 px-md-5 animated slideInRight">Register Now</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Carousel End -->
<!-- Service Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="service-item text-center pt-3">
                    <div class="p-4">
                        <i class="fa fa-3x fa-book-open text-primary mb-4"></i>
                        <h5 class="mb-3">Vast Book Collection</h5>
                        <p>From fiction to reference material, explore titles across every genre in our library.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="service-item text-center pt-3">
                    <div class="p-4">
                        <i class="fa fa-3x fa-arrow-right-arrow-left text-primary mb-4"></i>
                        <h5 class="mb-3">Easy Borrow &amp; Return</h5>
                        <p>Request a book in a couple of clicks and return it just as easily once you're done.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="service-item text-center pt-3">
                    <div class="p-4">
                        <i class="fa fa-3x fa-clock text-primary mb-4"></i>
                        <h5 class="mb-3">Track Due Dates &amp; Fines</h5>
                        <p>Your profile always shows what's due, what's overdue, and any fines owed — no surprises.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.7s">
                <div class="service-item text-center pt-3">
                    <div class="p-4">
                        <i class="fa fa-3x fa-heart text-primary mb-4"></i>
                        <h5 class="mb-3">Cart &amp; Wishlist</h5>
                        <p>Save books you're interested in and request several at once when you're ready to borrow.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Service End -->
<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s" style="min-height: 400px;">
                <div class="position-relative h-100">
                    <img class="img-fluid position-absolute w-100 h-100" src="~/assets/img/about.jpg" alt="" style="object-fit: cover;">
                </div>
            </div>
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.3s">
                <h6 class="section-title bg-white text-start text-primary pe-3">About Us</h6>
                <h1 class="mb-4">Welcome to Our Library</h1>
                <p class="mb-4">We built this platform to make borrowing books simple — no queues, no paperwork. Search the catalog, request a title, and we'll take care of the rest.</p>
                <div class="row gy-2 gx-4 mb-4">
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Extensive Book Collection</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Simple Borrow Requests</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Fine &amp; Due Date Tracking</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Personal Borrowing History</p>
                    </div>
                </div>
                <a class="btn btn-primary py-3 px-5 mt-2" asp-action="Books" asp-controller="Home">Browse Books</a>
            </div>
        </div>
    </div>
</div>
<!-- About End -->
<!-- Featured Books Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Library</h6>
            <h1 class="mb-5">Featured Books</h1>
        </div>

        @if (!Model.Any())
        {
            <p class="text-center text-muted">No books Available</p>
        }
        else
        {
            <div class="row g-3 justify-content-center">
                @foreach (var book in Model)
                {
                    <!-- Book Card-->
                    <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-6 d-flex justify-content-center wow fadeInUp" data-wow-delay="0.1s">
                        <div class="team-item bg-light w-100" style="max-width: 222px;">
                            <div class="overflow-hidden">
                                <img class="img-fluid w-100" src="~/BookImages/@book.BookImageName" alt="@book.BookName">
                                <div class="text-center p-3">
                                    <h5 class="mb-1" style="font-size: 15px;">@book.BookName</h5>
                                    <a asp-action="BooksDetail" asp-route-id="@book.BookId" asp-controller="Home"><small>Details</small></a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Book Card-->
                }
            </div>

            <div class="text-center mt-5">
                <a asp-action="Books" asp-controller="Home" class="btn btn-primary py-3 px-5">View All Books</a>
            </div>
        }
    </div>
</div>
<!-- Featured Books End -->