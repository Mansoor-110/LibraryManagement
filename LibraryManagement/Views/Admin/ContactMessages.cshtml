@model List<LibraryManagement.Models.ContactMessage>
@{
    Layout = "~/views/shared/_adminLayout.cshtml";
}
<!--**********************************
           Content body start
       ***********************************-->
<style>
    :root {
        --teal: #1cb8ba;
        --teal-dark: #149193;
        --teal-tint: #eafcfc;
        --navy: #14213d;
        --gray: #6f7c8e;
        --amber: #f2994a;
        --amber-tint: #fff4e8;
        --red: #e0575b;
        --red-tint: #fdeceb;
    }

    .badge-pill {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        padding: 5px 14px;
        border-radius: 20px;
    }

    .badge-pending {
        background: var(--amber-tint);
        color: var(--amber);
    }

    .badge-approved {
        background: var(--teal-tint);
        color: var(--teal-dark);
    }

    .msg-cell {
        max-width: 260px;
        white-space: normal;
        color: #555;
        font-size: 13px;
    }
</style>
<div class="content-body">
    <div class="container-fluid">
        <div class="row page-titles mx-0">
            <div class="col-sm-6 p-md-0">
                <div class="welcome-text">
                    <h4>Hi, welcome back!</h4>
                    <p class="mb-0">Your business dashboard template</p>
                </div>
            </div>
            <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Table</a></li>
                    <li class="breadcrumb-item active"><a href="javascript:void(0)">Bootstrap</a></li>
                </ol>
            </div>
        </div>
        <!-- row -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Contact Messages</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table primary-table-bordered table-responsive-sm text-muted">
                                <thead class="thead-primary">
                                    <tr class="text-primary">
                                        <th width="140px">Name</th>
                                        <th width="180px">Email</th>
                                        <th width="150px">Subject</th>
                                        <th width="260px">Message</th>
                                        <th width="110px">Submitted On</th>
                                        <th width="90px">Status</th>
                                        <th width="160px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Any())
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center">No messages found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var msg in Model)
                                        {
                                            <tr>
                                                <td>@msg.Name</td>
                                                <td>@msg.Email</td>
                                                <td>@msg.Subject</td>
                                                <td class="msg-cell">@msg.Message</td>
                                                <td>@msg.SubmittedAt.ToString("dd-MMMM-yy")</td>
                                                <td>
                                                    @if (msg.IsResolved)
                                                    {
                                                        <span class="badge-pill badge-approved">Resolved</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge-pill badge-pending">Pending</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        @if (!msg.IsResolved)
                                                        {
                                                            <form asp-action="MarkResolved" asp-controller="Admin" asp-route-id="@msg.ContactMessageId" method="post">
                                                                <button type="submit" class="btn btn-sm btn-primary">Mark Resolved</button>
                                                            </form>
                                                        }
                                                        <form asp-action="DeleteMessage" asp-controller="Admin" asp-route-id="@msg.ContactMessageId" method="post" onsubmit="return confirm('Do you want to delete this message?');">
                                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--**********************************
    Content body end
***********************************-->
