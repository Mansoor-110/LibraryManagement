@model IEnumerable<LibraryManagement.Models.Book>
@{
    Layout = "~/views/shared/_librarianLayout.cshtml";
}

<!--**********************************
            Content body start
***********************************-->
<div class="content-body">
    <div class="container-fluid">
        <div class="row page-titles mx-0">
            <div class="col-sm-6 p-md-0">
                <div class="welcome-text">
                    <h4>Hi, welcome back!</h4>
                    <p class="mb-0">Your business dashboard template</p>
                </div>
            </div>
            <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Table</a></li>
                    <li class="breadcrumb-item active"><a href="javascript:void(0)">Bootstrap</a></li>
                </ol>
            </div>
        </div>
        <!-- row -->

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Books Data</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive w-100">
                            <table class="table primary-table-bordered text-muted align-middle text-nowrap">
                                <thead class="thead-primary">
                                    <tr class="text-primary">
                                        <th>BookId</th>
                                        <th>BookImage</th>
                                        <th>BookName</th>
                                        <th>Quantity</th>
                                        <th>Qty For Borrow</th>
                                        <th>Price</th>
                                        <th>Is Active</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.BookId</td>
                                            <td>
                                                <img src="~/BookImages/@item.BookImageName" class="img-fluid rounded" style="max-width: 60px; height: auto;" alt="@item.BookName" />
                                            </td>
                                            <td>@item.BookName</td>
                                            <td>@item.quantity</td>
                                            <td>@item.qtyforborrow</td>
                                            <td>@item.BookPrice</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge badge-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">Inactive</span>
                                                }
                                            </td>

                                            <td>
                                                <span class="mx-1">
                                                    @* <a asp-action="BookEdit" asp-route-id="@item.BookId" ><i class="fa fa-pencil text-info" title="Edit"></i></a> *@
                                                </span>
                                                <span class="mx-1">
                                                    <!-- Button trigger modal -->
                                                    <a data-toggle="modal" data-target="#exampleModalCenter-@item.BookId" type="button" class="btn btn-sm btn-primary-light">
                                                        <i class="fa-solid fa-eye text-primary" title="View"></i>
                                                    </a>

                                                    <!-- Modal -->
                                                    <div class="modal fade" id="exampleModalCenter-@item.BookId" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title text-secondary" id="exampleModalLongTitle">Detail of this book</h5>
                                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                </div>
                                                                <div class="modal-body text-wrap">
                                                                    <div class="row align-items-center">
                                                                        <div class="col-md-4 text-center mb-3 mb-md-0">
                                                                            <img src="~/BookImages/@item.BookImageName" class="img-fluid rounded shadow-sm" style="max-width: 100%; max-height: 250px;" alt="@item.BookName" />
                                                                        </div>
                                                                        <div class="col-md-8">
                                                                            <ul class="list-group list-group-flush text-left">
                                                                                <li class="list-group-item"><strong>Book Name:</strong> <span class="text-black">@item.BookName</span></li>
                                                                                <li class="list-group-item"><strong>Description:</strong> <p class="mb-0">@item.BookDescription</p></li>
                                                                                <li class="list-group-item"><strong>Author:</strong> @item.BookAuthor</li>
                                                                                <li class="list-group-item"><strong>Pages:</strong> @item.BookPages</li>
                                                                                <li class="list-group-item"><strong>Language:</strong> @item.BookLanguage</li>
                                                                                <li class="list-group-item"><strong>Quantity:</strong> @item.quantity</li>
                                                                                <li class="list-group-item"><strong>Qty Available for Borrow:</strong> @item.qtyforborrow</li>
                                                                                <li class="list-group-item"><strong>Price:</strong> @item.BookPrice</li>
                                                                                <li class="list-group-item"><strong>Is Active:</strong> @item.IsActive</li>
                                                                            </ul>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--**********************************
    Content body end
***********************************-->
